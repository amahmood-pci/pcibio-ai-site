{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/education/cases/p53-ai", "destination": "/", "permanent": false },
    { "source": "/education/cases/p53-ai-case2", "destination": "/", "permanent": false },
    { "source": "/login", "destination": "https://pcibio.com/viewer.html", "permanent": false },
    { "source": "/register", "destination": "https://pcibio.com/viewer.html", "permanent": false },
    { "source": "/research", "destination": "/research/p53-cell-line-panel", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" }
      ]
    },
    {
      "source": "/static/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/static/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
